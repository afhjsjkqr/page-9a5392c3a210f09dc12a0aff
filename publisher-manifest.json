der-top:1px dashed var(--line);font-size:.85rem;color:var(--muted)}\n\n  /* ---------- 客户端区块 ---------- */\n  .client-grid{display:grid;grid-template-columns:1fr;gap:14px}\n  .client{background:var(--card);border-left:6px solid var(--violet);padding:20px 22px}\n  .client h3{margin-bottom:.3em}\n  .client p{font-size:.92rem;color:var(--ink-soft);margin-bottom:.6em}\n  .client .status{display:inline-block;font-size:.78rem;color:var(--muted);border:1px solid var(--line);border-radius:3px;padding:2px 9px}\n\n  /* ---------- 说明步骤 ---------- */\n  .steps{counter-reset:step;display:grid;gap:14px;margin:0;padding:0;list-style:none}\n  .steps li{counter-increment:step;position:relative;background:var(--card);border-left:6px solid var(--violet-soft);padding:20px 22px 20px 66px}\n  .steps li::before{content:counter(step);position:absolute;left:20px;top:18px;font-size:1.5rem;font-weight:800;color:var(--violet);line-height:1}\n  .steps b{display:block;margin-bottom:.25em}\n  .steps span{font-size:.93rem;color:var(--ink-soft)}\n\n  /* ---------- FAQ ---------- */\n  .faq-group h2{margin-bottom:1em}\n  details{background:var(--card);border-left:6px solid var(--violet);margin-bottom:10px;padding:0}\n  details summary{cursor:pointer;list-style:none;padding:16px 46px 16px 20px;font-weight:600;font-size:.98rem;position:relative}\n  details summary::-webkit-details-marker{display:none}\n  details summary::after{content:\"+\";position:absolute;right:20px;top:50%;transform:translateY(-50%);color:var(--violet);font-size:1.3rem;font-weight:400;line-height:1}\n  details[open] summary::after{content:\"–\"}\n  details .answer{padding:0 22px 20px 20px;font-size:.94rem;color:var(--ink-soft)}\n  details .answer p:last-child{margin-bottom:0}\n\n  /* ---------- 收尾 ---------- */\n  .closing{background:var(--ink);color:#eceaf2;padding:clamp(38px,6vw,64px) 0}\n  .closing h2{color:#fff}\n  .closing p{color:#b9b6c6;max-width:60ch}\n  .closing a{display:inline-block;margin-top:10px;background:var(--violet);color:#fff;text-decoration:none;font-weight:600;font-size:.93rem;padding:11px 22px;border-radius:4px}\n\n  footer{background:var(--paper-2);border-top:1px solid var(--line);padding:26px 0 30px;font-size:.83rem;color:var(--muted)}\n  footer p{margin:0 0 .4em}\n\n  /* ---------- 底部固定导航 ---------- */\n  .dock{position:fixed;left:0;right:0;bottom:0;height:var(--nav-h);background:rgba(255,255,255,.96);border-top:1px solid var(--line);backdrop-filter:blur(6px);z-index:20}\n  .dock-inner{max-width:1080px;margin:0 auto;height:100%;padding:0 14px;display:flex;align-items:center;gap:4px;overflow-x:auto;scrollbar-width:none}\n  .dock-inner::-webkit-scrollbar{display:none}\n  .dock a{flex:0 0 auto;text-decoration:none;font-size:.85rem;font-weight:600;color:var(--ink-soft);padding:8px 12px;border-radius:4px;white-space:nowrap}\n  .dock a:hover,.dock a:focus{background:var(--violet-soft);color:var(--violet)}\n  .dock .brand{font-weight:800;color:var(--ink);margin-right:6px;letter-spacing:-0.01em}\n\n  @media (min-width:760px){\n    .hero-top{grid-template-columns:minmax(0,1.05fr) minmax(0,.85fr);gap:48px;align-items:start}\n    .timeline{margin-top:8px}\n    .client-grid{grid-template-columns:1fr 1fr}\n    .plan{padding:30px 34px 28px}\n    .plan-body{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px 36px}\n  }\n</style><main>\n\n  <header class=\"hero\" id=\"top\">\n    <div class=\"wrap\">\n      <div class=\"hero-top\">\n        <div>\n          <p class=\"eyebrow\">BestVpn · 选择笔记</p>\n          <h1>选 <em>BestVpn</em> 之前，先把要比较的几件事写在纸上</h1>\n          <p class=\"hero-lede\">挑订阅不是比谁的数字更大。真正影响日常体验的，往往只有三样：每月流量够不够你用、同时在线的设备有几台、以及当问题出现时，你能在多长时间内得到一句有用的回复。这篇笔记按顺序把这三点摊开讲，方便你对照自己的习惯做决定。</p>\n          <ul class=\"hero-meta\">\n            <li>三档订阅</li>\n            <li>设备数量逐档递增</li>\n            <li>价格按月与按年并列</li>\n            <li>常见疑问集中折叠</li>\n          </ul>\n        </div>\n        <ol class=\"timeline\" aria-label=\"阅读顺序\">\n          <li>\n            <b>先看流量</b>\n            <span>把上个月的用量估个大概，再决定档位，别从最贵的开始看。</span>\n          </li>\n          <li>\n            <b>再数设备</b>\n            <span>手机、平板、电脑，加上家里共用的那台，一起算进去。</span>\n          </li>\n          <li>\n            <b>然后看线路差异</b>\n            <span>三档的差别不只在额度，也在节点池和响应优先级上。</span>\n          </li>\n          <li>\n            <b>最后读一遍问题区</b>\n            <span>关于计费周期、设备切换和团队使用的解释都在那里。</span>\n          </li>\n        </ol>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"why\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>为什么这三件事值得先想清楚</h2>\n        <p>订阅方案之间的差距，通常不体现在宣传语上，而体现在你第三周开始嫌它的时候。</p>\n      </div>\n      <article class=\"strip-card\">\n        <h3>流量是最容易估错的一项</h3>\n        <p>很多人第一次订阅会直接跳到中间档，理由只是“怕不够”。更实用的做法是先回看过去一个月的实际使用：如果主要用来读网页、收发文件，低档往往足够；如果经常同步较大的素材或长时间看视频，就往上挪一档。额度是唯一可以事后调整的东西，但调整本身也花时间。</p>\n      </article>\n      <article class=\"strip-card\">\n        <h3>设备数量决定你能否一次性交代清楚</h3>\n        <p>三台、五台、二十台，这组数字看着抽象，落到生活里其实很具体：三台是手机加电脑加平板；五台还要算上家里那台常开的设备；二十台意味着你已经在替一个小团队做安排。先数清楚，再看价格，判断会顺很多。</p>\n      </article>\n      <article class=\"strip-card\">\n        <h3>线路与响应，属于“平时感觉不到”的部分</h3>\n        <p>旗舰版和团队版提供的是节点池与支持优先级的差别。它们不会让你在第一天就察觉，却会在你最不希望出状况的时候体现价值。这部分没有统一答案，取决于你能接受多长的等待。</p>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>三档订阅，逐档摊开</h2>\n        <p>价格同时标出按月与按年两种口径。年付数字更低，但请确认你确实会用满一年。</p>\n      </div>\n\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>基础版</h3>\n          <span class=\"plan-tag\">起步档</span>\n        </div>\n        <div class=\"price-row\">\n          <span class=\"price\">¥15<small>/月</small></span>\n          <span class=\"annual\">按年付 ¥150/年</span>\n        </div>\n        <div class=\"plan-body\">\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <div>\n            <p class=\"note\">适合一个人用、设备不多、每月用量有明确上限的情况。如果你大部分时间只是浏览和查资料，这一档的好处是负担小、容易做决定。</p>\n          </div>\n        </div>\n        <p class=\"plan-foot\">计费周期与开通方式以购买页说明为准。</p>\n      </article>\n\n      <article class=\"plan is-featured\">\n        <div class=\"plan-head\">\n          <h3>旗舰版</h3>\n          <span class=\"plan-tag\">中间档 · 多数人先看这档</span>\n        </div>\n        <div class=\"price-row\">\n          <span class=\"price\">¥35<small>/月</small></span>\n          <span class=\"annual\">按年付 ¥350/年</span>\n        </div>\n        <div class=\"plan-body\">\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n          <div>\n            <p class=\"note\">五个设备、三百 GB、加上优先工单，这一档覆盖的是一周里大部分时间都在联网的人。相比基础版，多出来的不只是额度，还有出问题时被更早处理的可能。</p>\n          </div>\n        </div>\n        <p class=\"plan-foot\">年付口径下的单价更低，适合确定长期使用的人。</p>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>团队版</h3>\n          <span class=\"plan-tag\">多人场景</span>\n        </div>\n        <div class=\"price-row\">\n          <span class=\"price\">¥85<small>/月</small></span>\n          <span class=\"annual\">按年付 ¥850/年</span>\n        </div>\n        <div class=\"plan-body\">\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <div>\n            <p class=\"note\">二十台设备意味着分工和协调。如果有人负责维护、有人只是使用者，那么“专属客户经理”和“定制路由”这两项，实际省下的是沟通成本，而不只是钱。</p>\n          </div>\n        </div>\n        <p class=\"plan-foot\">团队场景的具体开通流程，建议先与客户经理确认。</p>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>在你手上的那些设备，大概是这样用的</h2>\n        <p>下面按设备类型说明常见的使用方式。下载地址本页不提供，请以官方渠道公布的信息为准。</p>\n      </div>\n      <div class=\"client-grid\">\n        <article class=\"client\">\n          <h3>手机</h3>\n          <p>最常被用来临时查看和切换。建议一开始就把账号信息存进密码管理器，避免换机时重新找回。同一个订阅下的设备切换，通常比新增设备更省额度。</p>\n          <span class=\"status\">日常主力</span>\n        </article>\n        <article class=\"client\">\n          <h3>台式与笔记本</h3>\n          <p>适合承担长时间连接的那部分工作。如果你的三档订阅里设备名额吃紧，可以把电脑设为常驻，手机按需上下线。</p>\n          <span class=\"status\">常驻连接</span>\n        </article>\n        <article class=\"client\">\n          <h3>平板与备用机</h3>\n          <p>往往是名额里最先被忽略的一台。数设备的时候记得把它加进去，否则到了要用的那天才发现超额。</p>\n          <span class=\"status\">按需使用</span>\n        </article>\n        <article class=\"client\">\n          <h3>家庭共用设备</h3>\n          <p>电视盒子、常开的媒体设备这一类，更适合放进旗舰版或团队版的名额里。基础版的三台名额，留给个人设备会更从容。</p>\n          <span class=\"status\">建议单独规划</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>如果你今天就要开始用</h2>\n        <p>四步，按顺序做，大约十分钟。</p>\n      </div>\n      <ol class=\"steps\">\n        <li>\n          <b>先估一个月的用量</b>\n          <span>回看过去一个月的实际使用，得出一个区间而不是一个精确数字，然后找覆盖这个区间的档位。</span>\n        </li>\n        <li>\n          <b>数一遍同时在线的设备</b>\n          <span>手机、电脑、平板、家里常开的设备，全部算上。留一台的余量，比刚好用完更舒服。</span>\n        </li>\n        <li>\n          <b>在月付与年付之间做选择</b>\n          <span>先用月付确认体验，再考虑年付。年付价格更低，但前提是你确定会用满一年。</span>\n        </li>\n        <li>\n          <b>把问题集中记下来</b>\n          <span>第一次使用遇到的疑问，先记在同一个地方，再去工单里一次性问清楚，比反复零散提问效率高。</span>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"faq-group\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>常见问题</h2>\n        <p>以下回答只基于本页列出的订阅信息与通用说明。涉及账户与订单的具体情况，请通过官方渠道确认。</p>\n      </div>\n\n      <details>\n        <summary>三档订阅最核心的差别是什么？</summary>\n        <div class=\"answer\">\n          <p>三处：每月流量额度、可同时在线的设备数量、以及节点池与支持优先级。基础版是 100GB 与 3 台设备，使用普通线路节点池；旗舰版是 300GB 与 5 台设备，并包含全节点原生流媒体解锁、IPLC 专线游戏加速优化与 7x24 优先工单支持；团队版是 1000GB 与 20 台设备，另有 VIP 专属高带宽节点、企业定制路由与专属客户经理。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>年付真的比月付划算吗？</summary>\n        <div class=\"answer\">\n          <p>本页标出的年付价格为：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年，对应月付 ¥15、¥35、¥85。数字上确实更低，但划算与否取决于你会不会用满一年。如果不确定，先用月付验证体验，再决定是否转年付，是更稳妥的顺序。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>设备数量是怎么算的？</summary>\n        <div class=\"answer\">\n          <p>指同时在线的设备台数：基础版 3 台、旗舰版 5 台、团队版 20 台。它不是终身名额，而是同时连接的额度。因此与其囤设备，不如按“平时最多会同时开几台”来算。把平板和备用机也数进去，往往更接近实际情况。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>流量用完了会怎样？</summary>\n        <div class=\"answer\">\n          <p>本页只列出各档的流量额度（100GB / 300GB / 1000GB），并未提供额度用尽后的具体处理规则。请以购买页或账户页面的说明为准，不要依据本页内容推断。如果你预计用量波动较大，选择更高一档通常比事后处理更省心。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>团队版是不是必须注册成公司才能买？</summary>\n        <div class=\"answer\">\n          <p>本页没有关于购买主体资格的信息，因此无法给出确定答复。团队版的差别主要体现在 20 台设备、1000GB 额度、VIP 专属高带宽节点、定制路由与专属客户经理这几项上。如果你只是设备多一点，可以先把旗舰版的 5 台用满再做打算。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>支持哪些设备？从哪里下载？</summary>\n        <div class=\"answer\">\n          <p>本页按手机、台式与笔记本、平板与备用机、家庭共用设备四类说明常见的使用方式，但不提供任何下载地址。出于可靠性的考虑，请通过官方渠道获取安装包，避免使用来路不明的第三方版本。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>可以先试用再决定吗？</summary>\n        <div class=\"answer\">\n          <p>本页没有可确认的试用政策信息，因此不作承诺。稳妥的做法是先选月付的基础版或旗舰版，用一段时间观察自己的实际用量与设备需求，再决定是否升级或转年付。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>从基础版升到旗舰版，会按比例补差价吗？</summary>\n        <div class=\"answer\">\n          <p>本页未提供升级计费规则，无法确认是否补差价或如何折算。这类问题涉及订单细节，建议在账户页面查看当下的选项，或通过官方支持渠道询问，避免仅凭推测操作。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>遇到问题应该怎么反馈？</summary>\n        <div class=\"answer\">\n          <p>旗舰版包含 7x24 优先工单支持，团队版包含专属客户经理服务。基础版没有列出额外的支持优先级说明。无论哪一档，把问题发生的时间、使用的设备与具体现象一次性写清楚，通常比反复追问更快得到有用的回复。</p>\n        </div>\n      </details>\n    </div>\n  </section>\n\n  <section class=\"closing\" id=\"end\">\n    <div class=\"wrap\">\n      <h2>把它当成一张对照表，而不是一句结论</h2>\n      <p>这篇笔记没有替你决定该买哪一档，因为答案取决于你的用量和你想同时连几台设备。基础版的 3 台、旗舰版的 5 台、团队版的 20 台，对应的是三种不同的日常。先对上号，价格反而成了最后一步。</p>\n      <a href=\"#plans\">回到订阅对照</a>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <p>BestVpn · 选择笔记</p>\n    <p>本页所列价格与权益以正文中的三档订阅为准；计费、开通、升级与支持的最终规则，请以官方渠道公布的信息为准。本页不提供下载地址，也不对未在此列出的事项作出说明。</p>\n  </div>\n</footer>\n\n<nav class=\"dock\" aria-label=\"页面导航\">\n  <div class=\"dock-inner\">\n    <a class=\"brand\" href=\"#top\">BestVpn</a>\n    <a href=\"#why\">先想清楚</a>\n    <a href=\"#plans\">订阅对照</a>\n    <a href=\"#clients\">设备使用</a>\n    <a href=\"#how\">开始使用</a>\n    <a href=\"#faq\">常见问题</a>\n  </div>\n</nav>",
